{
  "manifest_version": 3,
  "name": "nanocode",
  "description": "Lets nanocode computer use work in this browser, in background tabs grouped per session, without touching your own tabs.",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "nativeMessaging",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "nanocode"
  }
}
